---
/** The single-page portfolio, shared by / (en) and /ar/ (ar). */
import type { Locale } from '../data/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './layout/Navbar.astro';
import Footer from './layout/Footer.astro';
import ScrollChrome from './layout/ScrollChrome.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Skills from './sections/Skills.astro';
import Experience from './sections/Experience.astro';
import Projects from './sections/Projects.astro';
import Certifications from './sections/Certifications.astro';
import Education from './sections/Education.astro';
import Volunteering from './sections/Volunteering.astro';
import Contact from './sections/Contact.astro';
import CommandPalette from './overlays/CommandPalette.astro';
import Terminal from './overlays/Terminal.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---
<BaseLayout locale={locale}>
  <ScrollChrome locale={locale} />
  <Navbar locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <About locale={locale} />
    <Skills locale={locale} />
    <Experience locale={locale} />
    <Projects locale={locale} />
    <Certifications locale={locale} />
    <Education locale={locale} />
    <Volunteering locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <CommandPalette locale={locale} />
  <Terminal locale={locale} />
</BaseLayout>
