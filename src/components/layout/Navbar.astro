---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../data/types';
import { sections, sectionNumber } from '../../data/sections';
import { profile } from '../../data/profile';
import { useUi, homePath } from '../../lib/i18n';
import CvButton from '../ui/CvButton.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUi(locale);
const links = sections.map((s) => ({ ...s, label: ui.nav[s.id] }));
---
<header class="pointer-events-none fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4">
  <nav
    aria-label={ui.a11y.mainNav}
    class="nav-pill pointer-events-auto mx-auto flex max-w-[1168px] items-center gap-1 rounded-full border border-line py-1.5 ps-3 pe-1.5 shadow-lg shadow-black/10 sm:ps-4"
  >
    <a
      href={`${homePath(locale)}#top`}
      class="me-auto inline-flex min-h-11 items-center rounded-full px-2 font-mono text-[0.95rem] font-bold tracking-tight text-fg"
      aria-label={`${profile.initials}, ${ui.a11y.backToTop}`}
    >
      <bdi dir="ltr"><span class="text-accent">&lt;</span>{profile.initials}<span class="text-accent"> /&gt;</span></bdi>
    </a>

    <ul class="hidden items-center gap-0.5 lg:flex">
      {links.map((l) => (
        <li class:list={[l.nav === 'xl' && 'hidden xl:block']}>
          <a
            href={`#${l.id}`}
            data-nav-link={l.id}
            class="nav-link inline-flex min-h-11 items-center rounded-full px-3 text-sm font-medium text-muted transition-colors hover:text-fg"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1 ps-1">
      <ThemeToggle locale={locale} />
      <CvButton locale={locale} label="responsive" class="!rounded-full !px-4" />
      <button
        type="button"
        class="icon-btn lg:hidden"
        aria-label={ui.a11y.openMenu}
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-open
      >
        <Icon name="lucide:menu" class="size-5" aria-hidden="true" />
      </button>
    </div>
  </nav>
</header>

<!-- Mobile slide-in menu (native <dialog>: Esc to close, focus trapped, background inert) -->
<dialog id="mobile-menu" class="drawer" aria-label={ui.a11y.mainNav}>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b border-line px-5 py-3">
      <span class="font-mono font-bold text-fg">
        <bdi dir="ltr"><span class="text-accent">&lt;</span>{profile.initials}<span class="text-accent"> /&gt;</span></bdi>
      </span>
      <button type="button" class="icon-btn" aria-label={ui.a11y.closeMenu} data-menu-close>
        <Icon name="lucide:x" class="size-5" aria-hidden="true" />
      </button>
    </div>
    <ul class="flex-1 overflow-y-auto px-3 py-4">
      {links.map((l) => (
        <li>
          <a
            href={`#${l.id}`}
            data-nav-link={l.id}
            data-menu-link
            class="nav-link flex min-h-12 items-center gap-3 rounded-xl px-3 text-base font-medium text-muted hover:bg-surface-2 hover:text-fg"
          >
            <span class="font-mono text-xs text-subtle">{sectionNumber(l.id)}</span>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="grid gap-3 border-t border-line p-5">
      <CvButton locale={locale} class="w-full" />
    </div>
  </div>
</dialog>

<script>
  import '../../scripts/nav';
</script>

<style is:global>
  .nav-pill {
    background: var(--nav-bg);
    -webkit-backdrop-filter: saturate(150%) blur(14px);
    backdrop-filter: saturate(150%) blur(14px);
  }
  .nav-link[aria-current='true'] {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav-link[aria-current='true']::before {
    content: '';
    width: 0.35rem;
    height: 0.35rem;
    margin-inline-end: 0.45rem;
    border-radius: 999px;
    background: var(--accent);
  }

  /* ---------- slide-in drawer ---------- */
  dialog.drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    inset-inline-start: auto;
    margin: 0;
    width: min(20rem, 86vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    border-inline-start: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    translate: 100% 0;
    transition:
      translate 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }
  [dir='rtl'] dialog.drawer {
    translate: -100% 0;
  }
  dialog.drawer[open] {
    translate: 0 0;
  }
  @starting-style {
    dialog.drawer[open] {
      translate: 100% 0;
    }
    [dir='rtl'] dialog.drawer[open] {
      translate: -100% 0;
    }
  }
  dialog.drawer::backdrop {
    background: rgb(2 6 12 / 0.55);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }
</style>
