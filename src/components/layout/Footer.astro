---
/** Footer styled like a VS Code status bar. */
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../data/types';
import { profile } from '../../data/profile';
import { siteConfig } from '../../data/site.config';
import { tr, useUi } from '../../lib/i18n';

interface Props {
  locale: Locale;
  /** Terminal + palette buttons (only on pages that include those overlays). */
  showTools?: boolean;
}
const { locale, showTools = true } = Astro.props;
const ui = useUi(locale);
---
<footer class="mt-8 border-t border-line bg-bg-soft">
  <div
    class="container-page flex flex-wrap items-center gap-x-4 gap-y-2 py-3 font-mono text-[0.8rem] text-muted sm:justify-between"
  >
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      {siteConfig.availableForWork && (
        <span class="inline-flex items-center gap-2 text-success">
          <span class="status-dot" aria-hidden="true"></span>
          {ui.footer.available}
        </span>
      )}
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lucide:map-pin" class="size-3.5" aria-hidden="true" />
        {tr(profile.location, locale)}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lucide:git-branch" class="size-3.5" aria-hidden="true" />
        <bdi dir="ltr">main</bdi>
      </span>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      {showTools && (
        <>
          <button type="button" class="status-btn" data-terminal-open aria-haspopup="dialog" aria-label={ui.a11y.openTerminal}>
            <Icon name="lucide:square-terminal" class="size-3.5" aria-hidden="true" />
            <bdi dir="ltr">&gt;_ terminal</bdi>
          </button>
          <button type="button" class="status-btn" data-palette-open aria-haspopup="dialog" aria-label={ui.a11y.openCommandPalette}>
            <Icon name="lucide:command" class="size-3.5" aria-hidden="true" />
            <bdi dir="ltr" data-kbd-hint>Ctrl K</bdi>
          </button>
        </>
      )}
      <span class="inline-flex items-center gap-1.5">
        <Icon name="simple-icons:astro" class="size-3.5" aria-hidden="true" />
        {ui.footer.builtWith}
      </span>
      <span>© {siteConfig.copyrightYear} {tr(profile.name, locale)}</span>
    </div>
  </div>
</footer>

<style>
  .status-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    margin-inline: -0.5rem;
    border-radius: 0.4rem;
    color: var(--muted);
    transition: color 0.2s, background-color 0.2s;
  }
  .status-btn:hover {
    color: var(--accent);
    background: var(--surface-2);
  }
</style>
