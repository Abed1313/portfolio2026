---
/** Confidential enterprise RPA project: animated flow diagram instead of screenshots. No links. */
import { Icon } from 'astro-icon/components';
import type { Locale, RpaProject } from '../../data/types';
import { tr, useUi } from '../../lib/i18n';
import FlowDiagram from '../ui/FlowDiagram.astro';

interface Props {
  project: RpaProject;
  locale: Locale;
  index: number;
}
const { project, locale, index } = Astro.props;
const ui = useUi(locale);
---
<article class="reveal card card-hover flex flex-col overflow-hidden" style={`--i:${index % 3}`}>
  <div class="rpa-flow border-b border-line px-4 py-5 sm:px-5">
    <FlowDiagram steps={project.flow} locale={locale} orientation="horizontal" />
  </div>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="text-h3 font-semibold text-fg">{tr(project.title, locale)}</h3>
    <p class="mt-1 font-mono text-xs text-accent">{project.subtitle}</p>
    <p class="mt-3 text-muted">{tr(project.description, locale)}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {project.tags.map((t) => <li class="chip">{t}</li>)}
    </ul>
    <p class="mt-auto flex items-center gap-2 pt-5 text-xs text-subtle">
      <Icon name="lucide:lock" class="size-3.5" aria-hidden="true" />
      {ui.projects.confidential}
    </p>
  </div>
</article>

<style>
  .rpa-flow {
    background:
      radial-gradient(var(--dot) 1px, transparent 1px) 0 0 / 14px 14px,
      color-mix(in oklab, var(--surface-2) 60%, transparent);
  }
</style>
