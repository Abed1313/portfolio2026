---
/** Detail modal for one project: description, facts, tags, buttons, screenshot gallery. */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Locale, Project } from '../../data/types';
import { tr, useUi } from '../../lib/i18n';
import { getProjectCover, getProjectGallery } from '../../lib/images';
import ProjectBadges from './ProjectBadges.astro';
import ProjectLinks from './ProjectLinks.astro';

interface Props {
  project: Project;
  locale: Locale;
}
const { project, locale } = Astro.props;
const ui = useUi(locale);
const title = tr(project.title, locale);
const gallery = getProjectGallery(project.id);
const cover = getProjectCover(project.id);
/* Gallery screenshots if present; otherwise show the cover (if any) as a single image. */
const images = gallery.length ? gallery : cover ? [cover] : [];
const titleId = `project-${project.id}-title`;
---
<dialog id={`project-${project.id}`} class="modal" aria-labelledby={titleId}>
  <div class="flex h-full max-h-[inherit] flex-col">
    <header class="flex items-start gap-3 border-b border-line px-5 py-4 sm:px-7">
      <div class="min-w-0 flex-1">
        <h2 id={titleId} class="text-h3 font-semibold text-fg">{title}</h2>
        <p class="mt-0.5 font-mono text-xs text-accent">{tr(project.subtitle, locale)}</p>
      </div>
      <button type="button" class="icon-btn -me-2" data-dialog-close aria-label={ui.a11y.close}>
        <Icon name="lucide:x" class="size-5" aria-hidden="true" />
      </button>
    </header>

    <div class="flex-1 overflow-y-auto px-5 py-5 sm:px-7 sm:py-6">
      {images.length > 0 && (
        <div class="mb-6" data-gallery>
          <div class="relative">
            <div class="gallery rounded-xl" tabindex="0" aria-label={ui.projects.gallery}>
              {images.map((img, n) => (
                <figure class="m-0 overflow-hidden rounded-xl border border-line bg-surface-2">
                  <Image
                    src={img}
                    alt={`${title}: ${ui.projects.screenshot} ${n + 1}`}
                    widths={[480, 800, 1200, 1600]}
                    sizes="(min-width: 768px) 820px, 100vw"
                    class="aspect-video h-auto w-full object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
            {images.length > 1 && (
              <>
                <button type="button" class="gallery-nav start-2" data-gallery-step="-1" aria-label={ui.a11y.previous}>
                  <Icon name="lucide:chevron-left" class="size-5 rtl:-scale-x-100" aria-hidden="true" />
                </button>
                <button type="button" class="gallery-nav end-2" data-gallery-step="1" aria-label={ui.a11y.next}>
                  <Icon name="lucide:chevron-right" class="size-5 rtl:-scale-x-100" aria-hidden="true" />
                </button>
              </>
            )}
          </div>
          {images.length > 1 && (
            <p class="mt-2 text-center font-mono text-xs text-subtle">{ui.projects.gallery} · {images.length}</p>
          )}
        </div>
      )}

      <ProjectBadges project={project} locale={locale} showFeatured={!!project.featured} />

      <p class="mt-4 text-fg/90 prose-width">{tr(project.description, locale)}</p>
      {project.details?.map((d) => <p class="mt-3 text-fg/90 prose-width">{tr(d, locale)}</p>)}

      {(project.role || project.type || project.date) && (
        <dl class="mt-6 grid gap-4 rounded-xl border border-line bg-surface-2/60 p-4 text-sm sm:grid-cols-3">
          {project.role && (
            <div>
              <dt class="font-mono text-xs text-subtle">{ui.projects.role}</dt>
              <dd class="mt-0.5 text-fg">{tr(project.role, locale)}</dd>
            </div>
          )}
          {project.type && (
            <div>
              <dt class="font-mono text-xs text-subtle">{ui.projects.type}</dt>
              <dd class="mt-0.5 text-fg">{tr(project.type, locale)}</dd>
            </div>
          )}
          {project.date && (
            <div>
              <dt class="font-mono text-xs text-subtle">{ui.projects.date}</dt>
              <dd class="mt-0.5 text-fg">{tr(project.date, locale)}</dd>
            </div>
          )}
        </dl>
      )}

      <ul class="mt-6 flex flex-wrap gap-2">
        {project.tags.map((t) => <li class="chip">{t}</li>)}
      </ul>

      {project.note && (
        <p class="mt-6 flex items-start gap-2 text-sm text-muted">
          <Icon name="lucide:shield-check" class="mt-0.5 size-4 shrink-0 text-accent" aria-hidden="true" />
          {tr(project.note, locale)}
        </p>
      )}
    </div>

    <footer class="flex flex-wrap items-center gap-2 border-t border-line px-5 py-4 sm:px-7">
      <ProjectLinks project={project} locale={locale} size="md" />
      <button type="button" class="btn btn-ghost ms-auto" data-dialog-close>{ui.a11y.close}</button>
    </footer>
  </div>
</dialog>

<style>
  .gallery-nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: color-mix(in oklab, var(--surface) 85%, transparent);
    color: var(--text);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .gallery-nav:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
