---
/**
 * 404 page in terminal style. Cloudflare Pages serves dist/404.html for unknown routes.
 * Shown in English with an Arabic line + links to both home pages; the requested
 * path is filled in client-side.
 */
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { useUi } from '../lib/i18n';

const en = useUi('en');
const ar = useUi('ar');
---
<BaseLayout locale="en" title={`404 | ${en.notFound.title}`} description={en.notFound.description} noindex>
  <Navbar locale="en" tools={false} />
  <main id="main" class="relative isolate grid min-h-[100dvh] place-items-center overflow-hidden px-4 pt-28 pb-16">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="card w-full max-w-2xl overflow-hidden" dir="ltr">
      <div class="flex items-center gap-3 border-b border-line bg-surface-2/60 px-4 py-2.5">
        <div class="flex gap-1.5" aria-hidden="true">
          <span class="size-3 rounded-full bg-[#ff5f57]"></span>
          <span class="size-3 rounded-full bg-[#febc2e]"></span>
          <span class="size-3 rounded-full bg-[#28c840]"></span>
        </div>
        <span class="font-mono text-xs text-subtle">bash: 404</span>
      </div>
      <div class="grid gap-3 p-6 font-mono text-sm sm:p-8 sm:text-base">
        <p class="break-all text-muted">
          <span class="text-success">guest@abed</span>:<span class="text-syn-prop">~</span>$ cd <span class="text-syn-str" data-path>/unknown</span>
        </p>
        <h1 class="text-h2 font-bold text-danger">{en.notFound.title}</h1>
        <p class="font-sans text-muted">{en.notFound.description}</p>
        <p class="font-arabic text-muted" lang="ar" dir="rtl">{ar.notFound.description}</p>
        <p class="text-muted">
          <span class="text-success">guest@abed</span>:<span class="text-syn-prop">~</span>$ <span class="caret-404" aria-hidden="true"></span>
        </p>
        <div class="mt-3 flex flex-wrap gap-3 font-sans">
          <a href="/" class="btn btn-primary">
            <Icon name="lucide:house" class="size-4.5" aria-hidden="true" />
            {en.actions.goHome}
          </a>
          <a href="/ar/" class="btn btn-secondary" lang="ar">
            <Icon name="lucide:house" class="size-4.5" aria-hidden="true" />
            <span class="font-arabic">{ar.actions.goHome}</span>
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer locale="en" showTools={false} />
</BaseLayout>

<script>
  const el = document.querySelector('[data-path]');
  if (el) el.textContent = decodeURIComponent(location.pathname).slice(0, 120);
</script>

<style>
  .caret-404 {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink-404 1.1s steps(1) infinite;
  }
  @keyframes blink-404 {
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret-404 { animation: none; }
  }
</style>
